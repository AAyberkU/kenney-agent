{
  "name": "kenney-agent",
  "private": true,
  "version": "1.0.0",
  "description": "Kenney's CC0 game assets, indexed and searchable for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AAyberkU/kenney-agent.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "extract": "node tools/extract.mjs",
    "scrape-meta": "node tools/scrape-metadata.mjs",
    "extract-catalog": "node tools/extract-catalog-json.mjs",
    "query": "node catalog/query.mjs",
    "assets": "node bin/assets",
    "catalog": "node bin/assets catalog",
    "catalog:gen": "node bin/assets catalog gen",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "opentype.js": "2.0.0",
    "playwright": "1.64.1",
    "three": "0.186.1",
    "typescript": "^5.5.0",
    "vite": "^6.4.0"
  },
  "bin": {
    "assets": "./bin/assets"
  }
}
